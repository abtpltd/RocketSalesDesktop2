{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RocketSales Pharma AI Powered SFA Solution",
  "version": "0.3.0",
  "identifier": "net.rocketorder.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RocketSales Pharma AI Powered SFA Solution",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: rsmap: http://rsmap.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    },
    "publisher": "Maxpro Infotech Limited, Kenya",
    "copyright": "\u00a9 2026 Maxpro Infotech Limited, Kenya",
    "shortDescription": "RocketSales Pharma AI Powered SFA Solution"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFNjg5RThBMDAxMTVFNzQKUldSMFhoRUFpcDVvN3ZUL2pkTzNKR00yMFpseHMyQWxVNW1vekV1bllnYUdXUzRYZ3F6bitGV0IK",
      "endpoints": [
        "https://raw.githubusercontent.com/abtpltd/RocketSalesDesktop-updates/master/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}